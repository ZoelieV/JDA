node_modules/

# Fonds d'écran originaux (PNG lourds) : gardés en local uniquement.
# Le site utilise les versions générées (bg_web / bg_miniatures) par
# scripts/generer_cosmetiques.py.
site/DB/images/bg_ignore/

# Captures d'écran de vérification (Claude Code), locales uniquement.
site/captures_claude/

# Cache Python.
__pycache__/
*.pyc

# Données du serveur express local (server/server.js), régénérées.
site/DB/rooms.json
site/DB/local_boxes.json

# Réglages personnels de Claude Code.
**/.claude/settings.local.json

# Clés Supabase et sorties de scripts/courbes_boxes.js (données des joueurs).
scripts/.env
scripts/sortie/
