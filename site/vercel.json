    {
      "source": "/admin_ppc",
      "destination": "/admin",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/jouer",
      "destination": "/matchmaking/matchmaking"
    },
    {
      "source": "/match",
      "destination": "/matchmaking/match"
    },
    {
      "source": "/equipe",
      "destination": "/matchmaking/equipe"
    },
    {
      "source": "/world-boss",
      "destination": "/matchmaking/world_boss"
    },
    {
      "source": "/compte",
      "destination": "/my_account/my_account"
    },
    {
      "source": "/comptes",
      "destination": "/all_accounts/all_accounts"
    },
    {
      "source": "/classement",
      "destination": "/leaderboard"
    },
    {
      "source": "/historique",
      "destination": "/historique/historique"
    },
    {
      "source": "/regles",
      "destination": "/rules"
    },
    {
      "source": "/regles/simplifiees",
      "destination": "/regles_simplifiees"
    },
    {
      "source": "/regles/completes",
      "destination": "/regles_completes"
    },
    {
      "source": "/theorycraft",
      "destination": "/theorycraft/theorycraft"
    },
    {
      "source": "/tutoriel",
      "destination": "/tutorial"
    },
    {
      "source": "/admin",
      "destination": "/admin_ppc/admin_ppc"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://cdn.jsdelivr.net/npm/tesseract.js@5.1.1/ https://cdn.jsdelivr.net/npm/tesseract.js-core@5.1.1/ 'wasm-unsafe-eval'; worker-src 'self' blob:; connect-src 'self' https://cdn.jsdelivr.net/npm/tesseract.js-core@5.1.1/ https://cdn.jsdelivr.net/npm/@tesseract.js-data/eng/4.0.0_best_int/; img-src 'self' data: blob: https://cdn.discordapp.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'"
        }
      ]
    },
    {
      "source": "/DB/images/((?!.*\\.json$).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/DB/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/((?!api/).*)\\.(js|css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/DB/(.*)\\.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
